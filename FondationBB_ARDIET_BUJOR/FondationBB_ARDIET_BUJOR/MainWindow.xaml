<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Model="clr-namespace:FondationBB_ARDIET_BUJOR.Model" 
        x:Class="FondationBB_ARDIET_BUJOR.Windows.MainWindow"
        Title="Fondation Brigitte Bardot" Height="720" Width="1280" MinHeight="720" MinWidth="1280"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9"
        TextElement.FontFamily="Segoe UI, Tahoma, Geneva, Verdana, sans-serif">

    <Window.DataContext>
        <Model:Data/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B71C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#881414"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="MenuHeader" Grid.Row="0" Background="#004A99" Height="80" Visibility="Visible" Panel.ZIndex="10">
            <Grid.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.3" Color="Black"/>
            </Grid.Effect>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Source="/Images/logo.png" Margin="25,10" Width="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,25,0">

                <Button x:Name="btnAnimaux" Content="Animaux" Style="{StaticResource HeaderButtonStyle}" Click="btnMenu_Click"/>
                <Button x:Name="btnClients" Content="Clients" Style="{StaticResource HeaderButtonStyle}" Click="btnMenu_Click"/>
                <Button x:Name="btnAdoptions" Content="Adoptions" Style="{StaticResource HeaderButtonStyle}" Click="btnMenu_Click"/>
                <Button x:Name="btnDemandes" Content="Demandes" Style="{StaticResource HeaderButtonStyle}" Click="btnMenu_Click"/>
                <Button x:Name="btnStatistiques" Content="Statistiques" Style="{StaticResource HeaderButtonStyle}" Click="btnMenu_Click"/>

                <Rectangle Width="1" Height="30" Fill="#4DFFFFFF" Margin="15,0,15,0" VerticalAlignment="Center"/>

                <TextBlock x:Name="TxtNomEmploye" Text="Bienvenue" Foreground="#E0EBF5" FontWeight="Medium" FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0" TextWrapping="NoWrap"/>

                <Button x:Name="btnDeconnexion" Content="Déconnexion" Style="{StaticResource LogoutButtonStyle}" Margin="5,0,0,0" Click="btnDeconnexion_Click"/>
            </StackPanel>
        </Grid>

        <ContentControl x:Name="ZoneContenu" Grid.Row="1" Margin="0"/>
    </Grid>
</Window>