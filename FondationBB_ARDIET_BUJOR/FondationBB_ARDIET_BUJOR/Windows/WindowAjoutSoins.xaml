<Window x:Class="FondationBB_ARDIET_BUJOR.Windows.WindowAjoutSoins"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FondationBB_ARDIET_BUJOR.Windows"
        mc:Ignorable="d"
        Title="Ajout de Soins" Height="300" Width="550" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Sélectionnez le type de soin" Grid.Column="0" Margin="0,0,10,0" Padding="10">
            <Grid VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Liste des soins disponibles :" Margin="0,0,0,5" Grid.Row="0"/>
                <ComboBox x:Name="cbSoins" 
                          Grid.Row="1" 
                          Height="30" 
                          DisplayMemberPath="Libelle" />
            </Grid>
        </GroupBox>

        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Date du soin :" FontWeight="Bold" Margin="0,0,0,5" Grid.Row="0"/>
            <DatePicker x:Name="dpDateSoin" Grid.Row="1" Height="30"/>

            <UniformGrid Grid.Row="3" Columns="2" Height="40">
                <Button Content="Enregistrer" Background="#EF5350" Foreground="White" FontWeight="Bold" Margin="0,0,5,0" Click="btnEnregistrer_Click"/>
                <Button Content="Annuler" Background="#E0E0E0" Margin="5,0,0,0" Click="btnAnnuler_Click"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>