<Window x:Class="FondationBB_ARDIET_BUJOR.Windows.WindowClient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FondationBB_ARDIET_BUJOR.Windows"
        mc:Ignorable="d"
        Title="Fiche Client" Height="530" Width="650"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <ControlTemplate x:Key="ValidationTemplate">
            <DockPanel>
                <Border BorderBrush="#EF5350" BorderThickness="1.5" CornerRadius="3">
                    <AdornedElementPlaceholder x:Name="ControlCherche"/>
                </Border>
            </DockPanel>
        </ControlTemplate>

        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationTemplate}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Fiche client" Grid.Row="0" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#F9F9F9" CornerRadius="8" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Nom *" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="textNom" Grid.Row="0" Grid.Column="1" Margin="0,5" Height="28" VerticalContentAlignment="Center"
                         Text="{Binding Nom, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Prénom *" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="textPrenom" Grid.Row="1" Grid.Column="1" Margin="0,5" Height="28" VerticalContentAlignment="Center"
                         Text="{Binding Prenom, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Date Naissance" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
                <DatePicker x:Name="datePickerNaissance" Grid.Row="2" Grid.Column="1" Margin="0,5" Height="28" VerticalContentAlignment="Center"
                            SelectedDate="{Binding DateNaissance, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="N° &amp; Rue *" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="textNumero" Grid.Column="0" Height="28" VerticalContentAlignment="Center" Margin="0,0,5,0" Tag="N°"
                             Text="{Binding Numero, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox x:Name="textRue" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                             Text="{Binding Rue, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Label Content="CP &amp; Ville *" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
                <Grid Grid.Row="4" Grid.Column="1" Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="textCp" Grid.Column="0" Height="28" VerticalContentAlignment="Center" Margin="0,0,5,0"
                             Text="{Binding Cp, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox x:Name="textVille" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                             Text="{Binding Ville, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Label Content="Téléphone *" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="textTelephone" Grid.Row="5" Grid.Column="1" Margin="0,5" Height="28" VerticalContentAlignment="Center"
                         Text="{Binding Telephone, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Adresse Mail" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="textMail" Grid.Row="6" Grid.Column="1" Margin="0,5" Height="28" VerticalContentAlignment="Center"
                         Text="{Binding Mail, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="btnValider" Content="Valider" Width="150" Height="32" Margin="0,0,20,0" Background="#E0E0E0" IsDefault="True" Click="btnValider_Click"/>
            <Button x:Name="btnAnnuler" Content="Annuler" Width="150" Height="32" Background="#E0E0E0" IsCancel="True" Click="btnAnnuler_Click"/>
        </StackPanel>
    </Grid>
</Window>