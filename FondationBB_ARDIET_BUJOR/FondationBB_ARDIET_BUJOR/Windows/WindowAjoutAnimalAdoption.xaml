<Window x:Class="FondationBB_ARDIET_BUJOR.Windows.WindowAjoutAnimalAdoption"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FondationBB_ARDIET_BUJOR.Windows"
        mc:Ignorable="d"
        Title="Sélectionner un animal pour l'adoption" Height="550" Width="750"
        WindowStartupLocation="CenterOwner" Background="#FFFFFF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F9F9F9" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Nom animal" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtFiltreNom" Height="28" Margin="0,0,0,8" VerticalContentAlignment="Center" TextChanged="FiltreAnimal_Changed"/>
                    <TextBlock Text="Espèce / Race" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtFiltreEspece" Height="28" VerticalContentAlignment="Center" TextChanged="FiltreAnimal_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Sexe" FontWeight="SemiBold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Tous" Width="60" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbSexeTous" GroupName="GroupeSexe" IsChecked="True" Click="FiltreAnimal_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Mâle" Width="60" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbMale" GroupName="GroupeSexe" Click="FiltreAnimal_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Femelle" Width="60" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbFemelle" GroupName="GroupeSexe" Click="FiltreAnimal_Changed"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Statut" FontWeight="SemiBold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Tous" Width="80" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbStatutTous" GroupName="GroupeStatut" IsChecked="True" Click="FiltreAnimal_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Adopté" Width="80" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbAdopte" GroupName="GroupeStatut" Click="FiltreAnimal_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Au refuge" Width="80" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbAuRefuge" GroupName="GroupeStatut" Click="FiltreAnimal_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1" x:Name="dgAnimaux" ItemsSource="{Binding LesAnimaux}" 
                  AutoGenerateColumns="False" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                  MouseDoubleClick="DgAnimaux_MouseDoubleClick" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Image" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Viewbox Width="18" Height="18" Margin="5,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="Black" Data="M19,5V19H5V5H19M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M14.14,11.86L11.14,15.66L9,13.08L6,17H18L14.14,11.86Z" />
                                </Canvas>
                            </Viewbox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="I-CAD" Binding="{Binding Icad}" Width="*"/>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                <DataGridTextColumn Header="Espèce" Binding="{Binding UneRace.UneEspece.Libelle}" Width="*"/>
                <DataGridTextColumn Header="Race" Binding="{Binding UneRace.Libelle}" Width="*"/>
                <DataGridTextColumn Header="Sexe" Binding="{Binding UnSexe}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnAnnuler" Content="Annuler" Width="100" Height="30" Margin="0,0,10,0" IsCancel="True" Click="BtnAnnuler_Click"/>
            <Button x:Name="btnChoisir" Content="Choisir" Width="100" Height="30" FontWeight="Bold" Background="#007ACC" Foreground="White" Click="BtnChoisir_Click"/>
        </StackPanel>
    </Grid>
</Window>