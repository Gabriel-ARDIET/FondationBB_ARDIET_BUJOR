<Window x:Class="FondationBB_ARDIET_BUJOR.Windows.WindowAjoutComportement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FondationBB_ARDIET_BUJOR.Windows"
        mc:Ignorable="d"
        Title="Ajout de Comportement" 
        Width="400" 
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Sélectionnez un comportement" Grid.Row="0" Margin="0,0,0,15" Padding="10">
            <ComboBox x:Name="cbComportements" 
                      Height="30" 
                      VerticalAlignment="Center"
                      DisplayMemberPath="Libelle" />
        </GroupBox>

        <UniformGrid Grid.Row="1" Columns="2" Height="40">
            <Button Content="Enregistrer" Background="Red" Foreground="White" FontWeight="Bold" Margin="0,0,5,0" Click="btnEnregistrer_Click"/>
            <Button Content="Annuler" Background="#E0E0E0" Margin="5,0,0,0" Click="btnAnnuler_Click"/>
        </UniformGrid>
    </Grid>
</Window>