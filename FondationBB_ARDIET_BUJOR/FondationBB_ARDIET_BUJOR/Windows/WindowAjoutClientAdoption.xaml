<Window x:Class="FondationBB_ARDIET_BUJOR.Windows.WindowAjoutClientAdoption"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FondationBB_ARDIET_BUJOR.Windows"
        mc:Ignorable="d"
        Title="Choisir un client pour l'adoption" Height="500" Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F9F9F9" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Nom client" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtFiltreNom" Height="30" Margin="0,0,0,10" TextChanged="FiltreClient_Changed"/>

                <TextBlock Text="Prénom client" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtFiltrePrenom" Height="30" TextChanged="FiltreClient_Changed"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" x:Name="dgClients" AutoGenerateColumns="False" IsReadOnly="True" 
                  VerticalScrollBarVisibility="Auto" ItemsSource="{Binding}" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="*"/>
                <DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnSélectionner" Content="Sélectionner" Width="120" Height="30" Margin="0,0,10,0" IsDefault="True" Click="btnSelectionner_Click"/>
            <Button x:Name="btnAnnuler" Content="Annuler" Width="120" Height="30" IsCancel="True" Click="btnAnnuler_Click"/>
        </StackPanel>
    </Grid>
</Window>